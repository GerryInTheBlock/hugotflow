{
  "expo": {
    "name": "HugotFlow",
    "slug": "hugotflow",
    "scheme": "hugotflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F4F5",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.hugotgym.hugotflow"
    },
    "android": {
      "package": "ph.hugotgym.hugotflow",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E3061B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "HugotFlow",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HugotFlow uses your photos so you can attach a picture to an equipment report or your guardian consent.",
          "cameraPermission": "HugotFlow uses the camera so you can take a picture of broken equipment or your guardian consent documents.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5e47134-cf6b-4367-a36d-5105abe08c48"
      }
    },
    "owner": "gerrytapuyo",
    "icon": "./assets/images/icon.png"
  }
}
